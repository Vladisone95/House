{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "blender"
  ],
  "permissions": {
    "allow": [
      "Bash(uv run apartment validate*)",
      "Bash(uv run apartment plan*)",
      "Bash(uv run apartment sun*)",
      "Bash(uv run apartment variant list*)",
      "Bash(uv run apartment build*)",
      "Bash(uv run apartment render*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run ruff format*)",
      "Bash(uv sync*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "mcp__blender"
    ],
    "deny": [
      "Edit(models/**)",
      "Write(models/**)",
      "mcp__blender__generate_hyper3d_model_via_text",
      "mcp__blender__generate_hyper3d_model_via_images",
      "mcp__blender__generate_hunyuan3d_model"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_on_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
